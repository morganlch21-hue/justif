# Supabase (NOUVEAU projet dédié compta - pas celui de monte-escalier)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Qonto API
QONTO_LOGIN=votre-org-slug-1234
QONTO_SECRET_KEY=votre-secret-key
QONTO_BANK_ACCOUNT_ID=uuid-du-compte-principal

# PayPal API (optionnel — si non set, sync PayPal désactivé)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Extraction IA (au moins une des deux clés requise pour l'OCR)
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Gmail webhook (secret partagé avec Google Apps Script)
GMAIL_WEBHOOK_SECRET=un-long-secret-aleatoire

# Cron job (cron-job.org → /api/cron/sync-qonto)
CRON_SECRET=un-autre-long-secret

# Allowlist accès (CSV). Defaults : @cpbm.fr + morgan.lch21@gmail.com
ALLOWED_PORTAIL_DOMAINS=@cpbm.fr
ALLOWED_PORTAIL_EMAILS=morgan.lch21@gmail.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
